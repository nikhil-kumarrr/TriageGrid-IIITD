TRIAGE_ENV=development
TRIAGE_DATABASE_PATH=var/triagegrid.sqlite3
TRIAGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TINYFISH_API_KEY=
TINYFISH_ENABLED=false
VITE_API_BASE_URL=/api

# AI Care Assistant Server-Side LLM Configuration
# Active provider: gemini | grok | mock
ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GROK_API_KEY=

# Structured Memory Configuration
# Memory provider: sqlite (local development, default) | aws (Amazon DynamoDB)
MEMORY_PROVIDER=sqlite
AWS_REGION=ap-south-1
AWS_DYNAMODB_TABLE=triagegrid_memory
# Standard AWS credentials (when MEMORY_PROVIDER=aws and not using IAM instance roles)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
